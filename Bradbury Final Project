#### Age Standardization

Due to the differences in age distribution across populations of interest seen in the box plots above, the populations were age standardized for more accurate comparison.

```{r}
#Creating age groups to stratify the cohort
pregnancy_summary <- pregnancy_summary %>%
  mutate(age_group = cut(anchor_age,
                         breaks = c(15, 20, 25, 30, 35, 40, 45, 50, 55),
                         right = FALSE))

#calculating the rate of each age group
standard_pop <- pregnancy_summary %>%
  group_by(age_group) %>%
  dplyr::summarize(
    N = n()
  ) %>%
  mutate(weight = N / sum(N))  


#age standardization by race
age_specific_rates <- pregnancy_summary %>%
  group_by(race_collapsed, age_group) %>%
  dplyr::summarize(
    n = n(),
    gdm_cases = sum(has_GDM, na.rm = TRUE),
    rate = gdm_cases / n #rate of GDM by race and age group
  ) %>%
  ungroup()

age_std_data <- age_specific_rates %>%
  left_join(standard_pop, by = "age_group")

age_standardized_prevalence <- age_std_data %>%
  group_by(race_collapsed) %>%
  dplyr::summarize(
    age_standardized_prev = sum(rate * weight) * 100, #multiplying GDM prevalence by the weight of each age group to standardize the results
    .groups = "drop" 
  )

age_standardized_prevalence

#Age standardization by insurance
age_specific_rates_insurance <- pregnancy_summary %>%
  group_by(insurance, age_group) %>%
  dplyr::summarize(
    n = n(),
    gdm_cases = sum(has_GDM, na.rm = TRUE),
    rate = gdm_cases / n
  ) %>%
  ungroup()

age_std_data_insurance <- age_specific_rates_insurance %>%
  left_join(standard_pop, by = "age_group")

age_standardized_prevalence_insurance <- age_std_data_insurance %>%
  group_by(insurance) %>%
  dplyr::summarize(
    age_standardized_prev_insurance = sum(rate * weight) * 100   
  )

age_standardized_prevalence_insurance

```

