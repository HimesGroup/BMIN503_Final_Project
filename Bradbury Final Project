#### Data Cleaning

First, I created variables to identify patients who delivered at Beth Israel Hospital. I had to first create a variable for ICD codes related to a vaginal delivery or cesarean delivery because MIMIC-IV has a separate column for each ICD procedure code in a patient's chart. Once I created this variable indicating whether ICD codes of interest were present in any column, I created another variable to indicate whether a patient had a vaginal delivery or cesarean section. I then merged my has_vaginal_delivery variable with my has_cesarean variable to create one variable indicating whether a patient delivered at Beth Israel Hospital.

Next, I created a variable named has_GDM to identify patients with a diagnosis code for gestational diabetes. I then merged the admissions data set with the patient data set to combine patient age with demographics. I created a table called Pregnancy_Summary which joined my demographics table with the variables I created for procedures and diagnoses. Finally, I filtered the pregnancy_summary table to only include patients who delivered at Beth Israel.

For ease of analysis and to ensure none of my variables of interest were too small, I collapsed the variables for race and ethnicity to: White, Black, Asian, Hispanic, and Other/NA.

```{r}

#reading in MIMIC-IV datasets for diagnoses, patients, admissions, and procedures. 
diagnoses_icd <- read_csv("/Users/ainsleybradbury1/Downloads/mimic-iv-3.1/hosp/diagnoses_icd.csv.gz")
patients <- read_csv("/Users/ainsleybradbury1/Downloads/mimic-iv-3.1/hosp/patients.csv.gz")
admissions <- read_csv("/Users/ainsleybradbury1/Downloads/mimic-iv-3.1/hosp/admissions.csv.gz")
procedures_icd <- read_csv("/Users/ainsleybradbury1/Downloads/mimic-iv-3.1/hosp/procedures_icd.csv.gz")


#creating variables for delivery procedures (vaginal delivery or cesarean delivery) and a variable for either delivery type to later filter by patients who delivered at Beth Israel. MIMIC-IV data has a column for each ICD code that is in a pts chart, so I first identified delivery codes then made a variable for any pt who had a column that aligned with one of the many delivery codes. 

procedures_clean <- procedures_icd %>%
  mutate(
    # Vaginal delivery: ICD-9 72.x or ICD-10 10E0X
    is_vaginal_delivery = case_when( 
      icd_version == 9  & str_detect(icd_code, "^72")       ~ TRUE,
      icd_version == 10 & str_detect(icd_code, "^10E0X")     ~ TRUE,
      TRUE                                                   ~ FALSE
    ),

    # Cesarean delivery: ICD-9 74.x or ICD-10-PCS 10D00
    is_csection = case_when(
      icd_version == 9  & str_detect(icd_code, "^74")        ~ TRUE,
      icd_version == 10 & str_detect(icd_code, "^10D00")     ~ TRUE,
      TRUE                                                   ~ FALSE
    )
  ) %>%
  group_by(subject_id, hadm_id) %>%
  summarise(
    has_Vaginal_Delivery = any(is_vaginal_delivery),
    has_Cesarean         = any(is_csection),
    .groups = "drop"
  ) %>%
  mutate(delivery_flag = has_Vaginal_Delivery | has_Cesarean) #creating a variable for pts who delivered at Beth Israel

#Identify Gestational Diabetes Patients
diagnosis_flags <- diagnoses_icd %>%
  group_by(subject_id, hadm_id) %>%
  summarise(
    has_GDM = any(
      str_detect(icd_code, "^6488") |      
      str_detect(icd_code, "^O24[4]")       
    ),
    .groups = "drop"
  )

#Join admissions data with patient age
demo <- admissions %>%
  left_join(
    patients %>% dplyr::select(subject_id, anchor_age),
    by = "subject_id"
  )

#Join procedures and diagnosis data and filter so only patient seen for a delivery are included
pregnancy_summary <- demo %>%
  left_join(procedures_clean, by = c("subject_id", "hadm_id")) %>%
  left_join(diagnosis_flags, by = c("subject_id", "hadm_id")) %>%
  filter(delivery_flag == TRUE) %>%           
  mutate(
    has_GDM = replace_na(has_GDM, FALSE),
    has_Vaginal_Delivery = replace_na(has_Vaginal_Delivery, FALSE),
    has_Cesarean = replace_na(has_Cesarean, FALSE)
  )

#Race collapse
pregnancy_summary <- pregnancy_summary %>%
  mutate(
    race_collapsed = case_when(
      str_detect(race, "^WHITE")    ~ "White",
      str_detect(race, "^BLACK")    ~ "Black",
      str_detect(race, "^HISPANIC") ~ "Hispanic",
      race %in% c("SOUTH AMERICAN", "PORTUGUESE") ~ "Hispanic",
      str_detect(race, "^ASIAN")    ~ "Asian",
      race %in% c(
        "NATIVE HAWAIIAN OR OTHER PACIFIC ISLANDER",
        "AMERICAN INDIAN/ALASKA NATIVE"
      )                             ~ "Other/NA",
      TRUE                          ~ "Other/NA"
    ),
    race_collapsed = factor(
      race_collapsed,
      c("White", "Black", "Hispanic", "Asian", "Other/NA")
    )
  ) %>%
  filter(
    !is.na(race_collapsed),
    !is.na(anchor_age),
    !is.na(insurance)
  )



```

